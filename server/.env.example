NODE_ENV=development
PORT=5000
CORS_ORIGIN=http://localhost:4200
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=

# ── Stripe (TEST mode) ──────────────────────────────────────
# Get these from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_...

# Create a product + price in the Stripe test dashboard, then paste the Price ID here
# e.g. price_1Abc123...
STRIPE_PREMIUM_PRICE_ID=price_...

# Webhook secret — from: stripe listen --forward-to localhost:5003/api/payments/webhook
# (local dev) OR from Stripe Dashboard > Webhooks (production)
STRIPE_WEBHOOK_SECRET=whsec_...
